# Required: create this in the Portainer stack environment. Never commit the real key.
DEEPGRAM_API_KEY=

# Recommended defaults for BIGRIG's RTX 2070 Super.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-AU
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# Separate custom transcription terms with a pipe character.
DEEPGRAM_KEYTERMS=Normet|Charmec|Spraymec|Variomec|Multimec|Scamec|Utimec|Himec|Utilift

# Browser origins allowed to call the private API.
ALLOWED_ORIGINS=https://bill-support.vercel.app,http://localhost:8080

# Maximum uploaded recording size: 100 MB.
MAX_AUDIO_BYTES=104857600
